* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    width: 100%;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: linear-gradient(120deg, #1a1a2e, #16213e);
}

.calculator {
    backdrop-filter: blur(16px);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2rem;
    border-radius: 24px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    width: 100%;
    max-width: 420px;
}

.all {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
}

input {
    width: 100%;
    border: none;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    font-size: 2.5rem;
    text-align: right;
    color: #ffffff;
    outline: none;
}

input::placeholder {
    color: rgba(255, 255, 255, 0.5);
}

button {
    border: none;
    aspect-ratio: 1;
    width: 100%;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    font-size: 1.25rem;
    backdrop-filter: blur(4px);
    transition: all 0.3s ease;
}

.equalBtn {
    background: linear-gradient(135deg, #ff6b6b, #ff8e53);
    box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
}

.oparator {
    color: #00ff95;
    background: rgba(0, 255, 149, 0.1);
}

.ac {
    color: #ff6b6b;
    background: rgba(255, 107, 107, 0.1);
}

.del img {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
    filter: invert(100%);
}

button:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.1);
}

button:active {
    transform: translateY(0);
    background: rgba(255, 255, 255, 0.15);
}

@media screen and (max-width: 768px) {
    .calculator {
        max-width: 360px;
        padding: 1.5rem;
    }

    input {
        font-size: 2rem;
        padding: 1.2rem;
    }

    button {
        font-size: 1.1rem;
    }
}

@media screen and (max-width: 480px) {
    .calculator {
        max-width: 320px;
        padding: 1rem;
    }

    input {
        font-size: 1.75rem;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .all {
        gap: 0.6rem;
    }

    button {
        font-size: 1rem;
    }
}

@media screen and (max-width: 360px) {
    .calculator {
        max-width: 280px;
    }

    input {
        font-size: 1.5rem;
    }

    button {
        font-size: 0.9rem;
    }
}