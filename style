* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    width: 100%;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background: #0f0f0f;
}

.calculator {
    background: #1a1a1a;
    padding: 2.5rem;
    border-radius: 30px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    width: 100%;
    max-width: 400px;
    border: 1px solid #333;
}

.all {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
}

input {
    width: 100%;
    border: none;
    padding: 2rem 1.5rem;
    margin-bottom: 2rem;
    background: #2d2d2d;
    border-radius: 20px;
    font-size: 2.5rem;
    text-align: right;
    color: #ffffff;
    outline: none;
    box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.3);
}

input::placeholder {
    color: rgba(255, 255, 255, 0.3);
}

button {
    border: none;
    height: 70px;
    border-radius: 20px;
    font-size: 1.4rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: #2d2d2d;
    color: #ffffff;
    border: 1px solid #333;
}

.equalBtn {
    background: #4CAF50;
    color: white;
    grid-column: span 2;
    border: none;
}

.oparator {
    background: #333;
    color: #4CAF50;
}

.ac {
    background: #333;
    color: #ff4444;
}

.del img {
    width: 1.5rem;
    height: 1.5rem;
    object-fit: contain;
    filter: invert(100%);
}

button:hover {
    transform: translateY(-3px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    background: #363636;
}

button:active {
    transform: translateY(0);
    background: #2a2a2a;
}

/* Dark glowing effect on hover */
.equalBtn:hover {
    background: #45a049;
    box-shadow: 0 0 20px rgba(76, 175, 80, 0.3);
}

@media screen and (max-width: 768px) {
    .calculator {
        max-width: 360px;
        padding: 2rem;
    }

    button {
        height: 60px;
        font-size: 1.2rem;
    }

    input {
        font-size: 2.2rem;
        padding: 1.5rem;
    }
}

@media screen and (max-width: 480px) {
    .calculator {
        max-width: 320px;
        padding: 1.5rem;
    }

    .all {
        gap: 0.8rem;
    }

    button {
        height: 55px;
        font-size: 1.1rem;
        border-radius: 15px;
    }

    input {
        font-size: 1.8rem;
        padding: 1.2rem;
        margin-bottom: 1.5rem;
        border-radius: 15px;
    }
}

@media screen and (max-width: 360px) {
    .calculator {
        max-width: 290px;
        padding: 1rem;
    }

    .all {
        gap: 0.6rem;
    }

    button {
        height: 50px;
        font-size: 1rem;
    }

    input {
        font-size: 1.6rem;
        padding: 1rem;
        margin-bottom: 1rem;
    }
}